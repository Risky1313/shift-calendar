rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    // Each person can only read and write their own data, and only in the two places the app uses.
    match /users/{uid}/days/{day} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().size() <= 20;
    }
    match /users/{uid}/config/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && doc in ['tags', 'balances'];
    }
  }
}
